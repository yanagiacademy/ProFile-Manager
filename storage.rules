rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function lvl() {
      let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return u.get('admin', false) == true ? 'w' : u.get('perms', {}).get('documenti', 'n');
    }
    match /documenti/{id} {
      allow read: if request.auth != null && lvl() in ['r', 'w'];
      allow write: if request.auth != null && lvl() == 'w' && request.resource.size < 200 * 1024 * 1024;
      allow delete: if request.auth != null && lvl() == 'w';
    }
  }
}
