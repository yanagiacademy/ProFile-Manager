rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasAccount() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasAccount() && me().get('admin', false) == true; }
    function level(sec) { return isAdmin() ? 'w' : me().get('perms', {}).get(sec, 'n'); }

    /* Chiavi di cifratura dei contenuti su Telegram: una per sezione (id = nome della sezione).
       Le legge solo chi ha almeno la lettura su quella sezione; si creano una volta sola (chi scrive la sezione), non si modificano mai;
       solo l'admin può eliminarle (per sostituirle serve ricifrare tutto: vedi RESOCONTO). */
    match /chiavi/{id} {
      allow read: if hasAccount() && level(id) in ['r', 'w'];
      allow create: if hasAccount() && level(id) == 'w';
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* Coda dello Storico: gli account senza sessione Telegram (atleti, tecnici, operatori) vi accodano le proprie voci, CIFRATE con la chiave pubblica dello Storico.
       Le crea ognuno solo a proprio nome; le legge e le toglie solo l'admin, che le porta nello Storico. */
    match /storicoCoda/{id} {
      allow create: if hasAccount() && request.resource.data.keys().hasOnly(['by', 't', 'enc'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.enc is string && request.resource.data.enc.size() < 20000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /app/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }
    match /sections/{sec}/meta/{id} {
      allow read: if hasAccount() && level(sec) in ['r', 'w'];
      allow write: if hasAccount() && level(sec) == 'w';
    }
    /* Conservazione 10 anni (Archivio): un documento con conservaFinoTs nel futuro non si può eliminare,
       né si può accorciare o togliere il periodo di conservazione. */
    function protetto(d) { return d.get('conservaFinoTs', null) != null && d.conservaFinoTs > request.time; }

    match /sections/{sec}/items/{id}/chunks/{n} {
      allow read: if hasAccount() && level(sec) in ['r', 'w'];
      allow create, update: if hasAccount() && level(sec) == 'w';
      allow delete: if hasAccount() && level(sec) == 'w'
        && !(exists(/databases/$(database)/documents/sections/$(sec)/items/$(id))
             && protetto(get(/databases/$(database)/documents/sections/$(sec)/items/$(id)).data));
    }
    /* Eventi: iscrizioni e bonifici degli atleti stanno qui (non su Telegram), così funzionano anche per chi non ha Telegram.
       Ogni atleta crea e modifica solo la propria iscrizione (id = idEvento_uidAtleta) e legge solo la propria; l'admin le legge e le modifica tutte.
       Solo l'admin può segnare il pagamento come verificato (campo pagatoOk) ed eliminare. */
    function eventiOk() { return hasAccount() && level('eventi') in ['r', 'w']; }
    match /iscrizioni/{id} {
      allow read: if eventiOk() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if eventiOk() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.evento + '_' + request.auth.uid
        && request.resource.data.get('pagatoOk', false) == false;
      allow update: if eventiOk() && (isAdmin()
        || (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
            && request.resource.data.get('pagatoOk', false) == resource.data.get('pagatoOk', false)));
      allow delete: if isAdmin();
      match /chunks/{c} {
        allow read, write: if eventiOk()
          && (isAdmin() || get(/databases/$(database)/documents/iscrizioni/$(id)).data.uid == request.auth.uid);
      }
    }

    /* Email degli atleti (sezione Atleti): leggibile e scrivibile solo dall'admin, in una raccolta a parte
       così non finisce nelle schede degli atleti che vedono anche gli altri account. */
    match /atletiMail/{id} {
      allow read, write: if isAdmin();
    }

    /* Atleta loggato: legge SOLO la propria tessera e il proprio certificato medico (file compresi).
       atletiEmail/<email in minuscolo> = {atleta: idAtleta, atleti: [id, …]} lo scrive l'admin dalla scheda Atleti (più atleti possono avere la stessa email: un genitore con più figli);
       l'account può leggere solo la chiave uguale alla propria email. I file archiviati restano esclusi. */
    match /atletiEmail/{k} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email.lower() == k);
      allow list, write: if isAdmin();
    }
    function mioAtleta(aid) {
      return signedIn()
        && exists(/databases/$(database)/documents/atletiEmail/$(request.auth.token.email.lower()))
        && (get(/databases/$(database)/documents/atletiEmail/$(request.auth.token.email.lower())).data.atleta == aid
            || get(/databases/$(database)/documents/atletiEmail/$(request.auth.token.email.lower())).data.get('atleti', []).hasAny([aid]));
    }
    /* Tecnici: stessa logica degli atleti. tecniciMail/<idTecnico> = email (solo admin);
       tecniciEmail/<email in minuscolo> = {tecnici: [id, …]} la scrive l'admin dalla scheda Tecnici; l'account legge solo la chiave uguale alla propria email. */
    match /tecniciMail/{id} {
      allow read, write: if isAdmin();
    }
    match /tecniciEmail/{k} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email.lower() == k);
      allow list, write: if isAdmin();
    }
    function mioTecnico(tid) {
      return signedIn()
        && exists(/databases/$(database)/documents/tecniciEmail/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/tecniciEmail/$(request.auth.token.email.lower())).data.get('tecnici', []).hasAny([tid]);
    }
    /* la persona (atleta o tecnico) collegata all'account */
    function mio(id) { return mioAtleta(id) || mioTecnico(id); }
    /* tecniciTes/<idTecnico> = copia dei tesserini del tecnico (la scrive l'admin): serve al tecnico per leggere i propri tesserini */
    match /tecniciTes/{id} {
      allow read: if isAdmin() || mioTecnico(id);
      allow write: if isAdmin() || (hasAccount() && level('tessere') == 'w');
    }

    /* Dati personali dell'atleta: atletiDati = copia dei soli campi che l'atleta può vedere e modificare (la scrive l'admin);
       atletiModifiche = modifiche proposte dall'atleta (solo i campi della lista), che l'admin conferma o scarta. */
    match /atletiDati/{id} {
      allow read: if isAdmin() || mio(id);
      allow write: if isAdmin() || (hasAccount() && (level('atleti') == 'w' || level('tecnici') == 'w'));
    }
    match /atletiModifiche/{id} {
      allow read: if isAdmin() || mio(id);
      allow create, update: if isAdmin() || (mio(id)
        && request.resource.data.keys().hasOnly(['campi', 'at', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.campi.keys().hasOnly(['nome', 'cognome', 'sesso', 'anno', 'peso', 'altezza', 'grado', 'categoria', 'allenatore', 'tipo', 'kumi', 'tachi', 'ne', 'richieste', 'obiettivi', 'infortuni', 'nascita', 'cf', 'info']));
      allow delete: if isAdmin() || mio(id);
    }

    /* Richieste di atleti e tecnici: file (tessera, certificato medico, tesserino) con i dati che li accompagnano, in attesa dell'admin.
       richieste/<id> = {soggetto, ruolo, tipo, tes, campi:{…}, file:{nome,size,mime,chunks}, by, at, completa}; i blocchi del file stanno in richieste/<id>/chunks/<n>.
       La persona le crea e le legge/annulla solo se sue; l'admin le legge, le approva campo per campo e le elimina. Max 10 MB per file. */
    function richPropria(rid) { return signedIn() && get(/databases/$(database)/documents/richieste/$(rid)).data.by == request.auth.uid; }
    match /richieste/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if signedIn() && mio(request.resource.data.soggetto)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.completa == false
        && request.resource.data.tipo in ['tessera', 'certificato', 'tesserino', 'medaglia', 'test']
        && request.resource.data.ruolo in ['atleta', 'tecnico']
        && request.resource.data.keys().hasOnly(['soggetto', 'ruolo', 'tipo', 'tes', 'campi', 'file', 'by', 'at', 'completa'])
        && request.resource.data.campi.keys().hasOnly(['ente', 'numero', 'tipoTessera', 'stagione', 'emissione', 'scadenza', 'associazione', 'qualifica', 'sport', 'comitato', 'codAff', 'cf', 'certTipo', 'certScad', 'albo', 'altraNome', 'righe', 'nota', 'data', 'gara', 'posto'])
        && (request.resource.data.get('file', null) == null || request.resource.data.file.size <= 10485760);
      allow update: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid
        && resource.data.completa == false && request.resource.data.completa == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completa']));
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }
    match /richieste/{id}/chunks/{n} {
      allow read, delete: if isAdmin() || richPropria(id);
      allow create: if richPropria(id)
        && get(/databases/$(database)/documents/richieste/$(id)).data.completa == false;
    }

    /* Ordini. Il catalogo (sections/ordini, kind 'prodotto', con copia su Firebase) lo leggono gli atleti; gli ordini inviati stanno in ordiniInviati/<id>:
       l'atleta li crea per sé (solo se atleta collegato alla sua email) e li annulla finché sono «inviato»; chi ha Ordini in scrittura li gestisce. */
    function ordAdmin() { return isAdmin() || (hasAccount() && level('ordini') == 'w'); }
    function ordVede() { return isAdmin() || (hasAccount() && level('ordini') in ['r', 'w']); }
    match /sections/ordini/items/{id} {
      allow read: if signedIn() && resource.data.kind == 'prodotto' && resource.data.attivo == true
        && exists(/databases/$(database)/documents/atletiEmail/$(request.auth.token.email.lower()));
    }
    match /ordiniInviati/{id} {
      allow read: if ordVede() || (signedIn() && resource.data.by == request.auth.uid);
      allow create: if signedIn() && (mioAtleta(request.resource.data.atleta) || ordAdmin())
        && request.resource.data.by == request.auth.uid
        && request.resource.data.stato == 'inviato'
        && request.resource.data.keys().hasOnly(['atleta', 'esterno', 'nome', 'cognome', 'righe', 'nota', 'stato', 'by', 'at'])
        && (request.resource.data.get('esterno', false) == false || request.resource.data.nome.size() > 0)
        && request.resource.data.righe is list && request.resource.data.righe.size() > 0 && request.resource.data.righe.size() <= 30
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 1000;
      allow update: if ordAdmin();
      allow delete: if ordAdmin() || (signedIn() && resource.data.by == request.auth.uid && resource.data.stato == 'inviato');
    }

    match /sections/tessere/items/{id} {
      allow get: if mio(id)
        || ((mio(resource.data.get('tesAtl', '')) || mio(resource.data.get('tesTec', ''))) && resource.data.get('archiviatoIl', null) == null);
    }
    match /sections/tessere/items/{id}/chunks/{n} {
      allow read: if (mio(get(/databases/$(database)/documents/sections/tessere/items/$(id)).data.get('tesAtl', ''))
          || mio(get(/databases/$(database)/documents/sections/tessere/items/$(id)).data.get('tesTec', '')))
        && get(/databases/$(database)/documents/sections/tessere/items/$(id)).data.get('archiviatoIl', null) == null;
    }

    match /sections/{sec}/items/{id} {
      allow read: if hasAccount() && level(sec) in ['r', 'w'];
      allow create: if hasAccount() && level(sec) == 'w';
      allow update: if hasAccount() && level(sec) == 'w'
        && (!protetto(resource.data)
            || (request.resource.data.get('conservaFinoTs', null) != null
                && request.resource.data.conservaFinoTs >= resource.data.conservaFinoTs));
      allow delete: if hasAccount() && level(sec) == 'w' && !protetto(resource.data);
    }
  }
}
